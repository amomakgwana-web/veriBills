PAYMENT_GATEWAY_SECRET=

TOKEN_VENDOR_PROVIDER=mock             # mock | eskom | prepaid24
TOKEN_VENDOR_KEY=
TOKEN_VENDOR_SECRET=

DEBICHECK_PROVIDER=mock                # mock | netcash | bankserv
DEBICHECK_KEY=
DEBICHECK_SECRET=

EMAIL_PROVIDER=mock                    # mock | sendgrid | ses | postmark
EMAIL_API_KEY=
EMAIL_FROM=billing@bipraestates.co.za

SMS_PROVIDER=mock                      # mock | clickatell | smsportal | twilio
SMS_API_KEY=
